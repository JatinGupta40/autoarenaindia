<?php

/**
 * @file
 * Car / variant catalog behaviour.
 *
 * A car (generation) owns its variants as `variant` paragraphs in
 * field_car_variants. Each variant lists the powertrains (engine +
 * transmission) it is sold with in field_powertrains, and those rows are the
 * source of truth for price and specs. The car carries derived summary fields
 * — price range and the union of fuel types / transmissions — so listings can
 * filter and sort on cars via JSON:API. Those fields are recomputed on every
 * car save and are never edited by hand.
 */

use Drupal\node\NodeInterface;

/**
 * Implements hook_ENTITY_TYPE_presave() for node.
 */
function autoarena_catalog_node_presave(NodeInterface $node) {
  if ($node->bundle() === 'cars') {
    autoarena_catalog_summarize_variants($node);
  }
}

/**
 * Implements hook_cloned_node_alter().
 *
 * Quick Node Clone duplicates the variant paragraphs itself. Only the legacy
 * node references need dropping, so a clone never points at the original's
 * car_variants nodes.
 *
 * @todo Remove with field_variants in phase 2 of the paragraph migration.
 */
function autoarena_catalog_cloned_node_alter(NodeInterface $node, NodeInterface $original) {
  if ($node->bundle() === 'cars' && $node->hasField('field_variants')) {
    $node->set('field_variants', []);
  }
}

/**
 * Recomputes a car's derived fields from its published variants.
 */
function autoarena_catalog_summarize_variants(NodeInterface $car): void {
  $prices = [];
  $fuels = [];
  $transmissions = [];
  foreach ($car->get('field_car_variants') as $item) {
    $variant = $item->entity;
    if (!$variant || !$variant->isPublished()) {
      continue;
    }
    foreach ($variant->get('field_powertrains') as $powertrain) {
      if (is_numeric($powertrain->ex_showroom_price)) {
        $prices[] = (int) $powertrain->ex_showroom_price;
      }
      if ($powertrain->fuel_type) {
        $fuels[$powertrain->fuel_type] = $powertrain->fuel_type;
      }
      if ($powertrain->transmission) {
        $transmissions[$powertrain->transmission] = $powertrain->transmission;
      }
    }
  }

  $car->set('field_price_min', $prices ? min($prices) : NULL);
  $car->set('field_price_max', $prices ? max($prices) : NULL);
  $car->set('field_fuel_type', array_values($fuels));
  $car->set('field_transmission', array_values($transmissions));
}
